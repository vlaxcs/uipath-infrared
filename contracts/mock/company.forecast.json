{
  "schema_version": "1.0",
  "id": "company-2027-plan",
  "description": "The company that runs in Floci: one estate, seven projects from its financial roadmap, each found by its tags first, then by resource names, and scaling on its own users.",
  "horizon_months": 36,
  "currency": "EUR",
  "scenarios": {
    "low": {
      "probability": 0.2,
      "monthly_multiplier": {
        "traffic": 1.005,
        "data": 1.01
      },
      "note": "Market flat."
    },
    "base": {
      "probability": 0.6,
      "monthly_multiplier": {
        "traffic": 1.02,
        "data": 1.03
      },
      "note": "Roadmap delivered, ~27% traffic growth/year."
    },
    "high": {
      "probability": 0.2,
      "monthly_multiplier": {
        "traffic": 1.04,
        "data": 1.05
      },
      "note": "Marketplace launch lands well."
    }
  },
  "hard_constraints": {
    "data_residency": {
      "allowed_regions": [
        "eu-*",
        "onprem-dc1"
      ],
      "applies_to": [
        "pii",
        "confidential"
      ]
    },
    "budget": {
      "max_monthly_run_cost_eur": 320000,
      "max_one_off_migration_cost_eur": 300000
    },
    "min_availability_pct": 99.5,
    "allowed_providers": [
      "aws",
      "supabase",
      "neon",
      "hetzner",
      "fly",
      "cloudflare",
      "backblaze",
      "runpod",
      "onprem"
    ],
    "max_migration_effort_hours": 2600,
    "max_cutover_downtime_hours": 4,
    "security_gates": {
      "forbid_public_datastores": true,
      "require_encryption_at_rest": true,
      "forbid_world_open_admin_ports": true,
      "require_audit_logging": true,
      "require_backups": true
    },
    "forbidden_providers": []
  },
  "cto_settings": {
    "ha_level": "multi_az",
    "min_zones": 2,
    "weights": {
      "cost": 0.5,
      "risk": 0.35,
      "effort": 0.15
    },
    "tie_break": "lower_risk",
    "strategies_enabled": [
      "do_nothing",
      "cleanup_orphans",
      "rightsize_in_place",
      "managed_services",
      "consolidate",
      "move_to_onprem"
    ]
  },
  "business": {
    "downtime_cost_per_hour_eur": 6500,
    "downtime_cost_by_stack": {
      "clinic-dev": 0,
      "clinic-staging": 0,
      "fleet-dev": 0,
      "dev": 0,
      "legacy": 800,
      "ml-experiments": 0
    },
    "engineer_hourly_eur": 85,
    "discount_rate_annual": 0.08
  },
  "projects": [
    {
      "id": "startup",
      "name": "Receipt scanner",
      "stacks": [
        "startup"
      ],
      "match": {
        "tags": [
          "startup",
          "receipt-scanner"
        ],
        "names": [
          "startup-"
        ]
      },
      "users": {
        "metric": "monthly_active_users",
        "current": 6500,
        "expected": [
          {
            "month": 24,
            "low": 8500,
            "base": 13600,
            "high": 21700
          }
        ]
      }
    },
    {
      "id": "clinic-booking",
      "name": "Clinic booking",
      "stacks": [
        "clinic-dev",
        "clinic-prod",
        "clinic-staging"
      ],
      "match": {
        "tags": [
          "clinic-booking",
          "clinic"
        ],
        "names": [
          "clinic-"
        ]
      },
      "users": {
        "metric": "monthly_active_users",
        "current": 41000,
        "expected": [
          {
            "month": 24,
            "low": 70300,
            "base": 112500,
            "high": 178500
          },
          {
            "month": 36,
            "low": 80000,
            "base": 140000,
            "high": 230000
          }
        ]
      }
    },
    {
      "id": "fleet-telemetry",
      "name": "Fleet telemetry",
      "stacks": [
        "fleet-dev",
        "fleet-prod"
      ],
      "match": {
        "tags": [
          "fleet-telemetry",
          "fleet"
        ],
        "names": [
          "fleet-"
        ]
      },
      "users": {
        "metric": "daily_active_users",
        "current": 3200,
        "expected": [
          {
            "month": 18,
            "low": 6900,
            "base": 10700,
            "high": 16400
          },
          {
            "month": 36,
            "low": 8000,
            "base": 15000,
            "high": 26000
          }
        ]
      }
    },
    {
      "id": "storefront",
      "name": "Storefront",
      "stacks": [
        "shop"
      ],
      "match": {
        "tags": [
          "storefront",
          "shop"
        ],
        "names": [
          "shop-",
          "web-asg"
        ]
      },
      "users": {
        "metric": "monthly_active_users",
        "current": 1200000,
        "expected": [
          {
            "month": 36,
            "low": 2010400,
            "base": 3427000,
            "high": 6894600
          }
        ]
      }
    },
    {
      "id": "data-platform",
      "name": "Data platform",
      "stacks": [
        "data"
      ],
      "match": {
        "tags": [
          "data-platform"
        ],
        "names": [
          "data-",
          "events-raw",
          "clickstream",
          "old-etl-"
        ]
      },
      "users": {
        "metric": "internal_users",
        "current": 120,
        "expected": [
          {
            "month": 36,
            "low": 130,
            "base": 160,
            "high": 220
          }
        ]
      }
    },
    {
      "id": "ml-experiments",
      "name": "ML experiments",
      "stacks": [
        "ml-experiments"
      ],
      "match": {
        "tags": [
          "ml-experiments"
        ],
        "names": [
          "ml-experiments"
        ]
      },
      "users": {
        "metric": "internal_users",
        "current": 25,
        "expected": [
          {
            "month": 12,
            "low": 25,
            "base": 35,
            "high": 50
          },
          {
            "month": 36,
            "low": 30,
            "base": 45,
            "high": 70
          }
        ]
      }
    },
    {
      "id": "back-office",
      "name": "Back office (legacy ERP)",
      "stacks": [
        "legacy"
      ],
      "match": {
        "tags": [
          "back-office",
          "legacy",
          "erp"
        ],
        "names": [
          "legacy-"
        ]
      },
      "users": {
        "metric": "internal_users",
        "current": 380,
        "expected": [
          {
            "month": 36,
            "low": 380,
            "base": 400,
            "high": 430
          }
        ]
      }
    }
  ]
}
