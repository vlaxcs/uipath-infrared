{
  "schema_version": "1.0",
  "id": "northwind-2027-plan",
  "description": "Northwind: ten applications in one estate, each scaling on its own users.",
  "horizon_months": 36,
  "currency": "EUR",
  "scenarios": {
    "low": {
      "probability": 0.2,
      "monthly_multiplier": {
        "traffic": 1.005,
        "data": 1.01
      },
      "note": "Market flat."
    },
    "base": {
      "probability": 0.6,
      "monthly_multiplier": {
        "traffic": 1.02,
        "data": 1.03
      },
      "note": "Roadmap delivered, ~27% traffic growth/year."
    },
    "high": {
      "probability": 0.2,
      "monthly_multiplier": {
        "traffic": 1.04,
        "data": 1.05
      },
      "note": "Marketplace launch lands well."
    }
  },
  "hard_constraints": {
    "data_residency": {
      "allowed_regions": [
        "eu-*",
        "onprem-dc1"
      ],
      "applies_to": [
        "pii",
        "confidential",
        "unknown"
      ]
    },
    "budget": {
      "max_monthly_run_cost_eur": 320000,
      "max_one_off_migration_cost_eur": 300000
    },
    "min_availability_pct": 99.5,
    "allowed_providers": [
      "aws",
      "supabase",
      "neon",
      "hetzner",
      "fly",
      "cloudflare",
      "backblaze",
      "runpod",
      "onprem"
    ],
    "max_migration_effort_hours": 2600,
    "max_cutover_downtime_hours": 4,
    "security_gates": {
      "forbid_public_datastores": true,
      "require_encryption_at_rest": true,
      "forbid_world_open_admin_ports": true,
      "require_audit_logging": true,
      "require_backups": true
    }
  },
  "cto_settings": {
    "ha_level": "multi_az",
    "min_zones": 2,
    "weights": {
      "cost": 0.5,
      "risk": 0.35,
      "effort": 0.15
    },
    "tie_break": "lower_risk",
    "strategies_enabled": [
      "do_nothing",
      "cleanup_orphans",
      "rightsize_in_place",
      "managed_services",
      "consolidate",
      "move_to_onprem"
    ]
  },
  "business": {
    "downtime_cost_per_hour_eur": 6500,
    "downtime_cost_by_stack": {
      "clinic-booking-dev": 0,
      "clinic-booking-staging": 0,
      "fleet-dev": 0,
      "storefront-staging": 0,
      "erp": 800
    },
    "engineer_hourly_eur": 85,
    "discount_rate_annual": 0.08
  },
  "projects": [
    {
      "id": "storefront",
      "name": "Storefront",
      "stacks": [
        "storefront-prod",
        "storefront-staging"
      ],
      "users": {
        "metric": "monthly_active_users",
        "current": 1200000,
        "expected": [
          {
            "month": 36,
            "low": 2010400,
            "base": 3427000,
            "high": 6894600
          }
        ]
      }
    },
    {
      "id": "data-platform",
      "name": "Data platform",
      "stacks": [
        "data-platform-prod"
      ],
      "users": {
        "metric": "internal_users",
        "current": 120,
        "expected": [
          {
            "month": 36,
            "low": 130,
            "base": 160,
            "high": 220
          }
        ]
      }
    },
    {
