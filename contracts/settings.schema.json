{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infrared.local/contract/settings.schema.json",
  "title": "Infrared account settings",
  "description": "What the Settings app reads and writes for one customer account: subscription and billing, read-only cloud connections, and the GitHub App installation that powers the Chrome extension and phase 2 migration pull requests. Mirrors AccountSettings in apps/settings/src/domain/types.ts; change both together.",
  "type": "object",
  "required": ["account", "subscription", "cloud", "github"],
  "additionalProperties": false,
  "properties": {
    "account": { "$ref": "#/$defs/account" },
    "subscription": { "$ref": "#/$defs/subscription" },
    "cloud": {
      "type": "array",
      "description": "Cloud connections, newest last. Revoked connections stay listed until removed.",
      "items": { "$ref": "#/$defs/cloud_connection" }
    },
    "github": { "$ref": "#/$defs/github_installation" }
  },
  "$defs": {
    "account": {
      "type": "object",
      "required": ["id", "company", "ownerEmail"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "company": { "type": "string", "minLength": 1 },
        "ownerEmail": { "type": "string", "format": "email" }
      }
    },
    "plan": {
      "enum": ["none", "run_pack", "subscription"],
      "description": "none = no paid plan; run_pack = prepaid runs, one-time; subscription = monthly."
    },
    "payment_method": {
      "type": "object",
      "required": ["brand", "last4", "expMonth", "expYear"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Payment processor id (Stripe pm_...). The card number never reaches the API." },
        "brand": { "type": "string", "minLength": 1 },
        "last4": { "type": "string", "pattern": "^\\d{4}$" },
        "expMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
        "expYear": { "type": "integer", "minimum": 2000 }
      }
    },
    "invoice": {
      "type": "object",
      "required": ["id", "date", "description", "amountUsd", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "amountUsd": { "type": "number", "minimum": 0 },
        "status": { "enum": ["paid", "open", "failed"] },
        "paymentIntentId": { "type": "string", "minLength": 1, "description": "The charge behind the invoice (Stripe pi_...)." }
      }
    },
    "pending_payment": {
      "type": "object",
      "description": "A payment waiting for 3-D Secure; the plan changes only once it is completed.",
      "required": ["intentId", "purchase", "amountUsd", "description"],
      "additionalProperties": false,
      "properties": {
        "intentId": { "type": "string", "minLength": 1 },
        "purchase": { "enum": ["run_pack", "subscription"] },
        "amountUsd": { "type": "number", "minimum": 0 },
        "description": { "type": "string" }
      }
    },
    "subscription": {
      "type": "object",
      "required": ["plan", "status", "runsRemaining", "renewsAt", "cancelAtPeriodEnd", "paymentMethod", "pendingPayment", "invoices"],
      "additionalProperties": false,
      "properties": {
        "plan": { "$ref": "#/$defs/plan" },
        "status": { "enum": ["active", "past_due", "canceled"] },
        "runsRemaining": { "type": "integer", "minimum": 0 },
        "renewsAt": { "type": ["string", "null"], "format": "date", "description": "Next renewal date; null when nothing renews." },
        "cancelAtPeriodEnd": { "type": "boolean" },
        "paymentMethod": {
          "oneOf": [{ "$ref": "#/$defs/payment_method" }, { "type": "null" }]
        },
        "pendingPayment": {
          "oneOf": [{ "$ref": "#/$defs/pending_payment" }, { "type": "null" }]
        },
        "invoices": { "type": "array", "items": { "$ref": "#/$defs/invoice" } }
      }
    },
    "cloud_connection": {
      "type": "object",
      "required": ["id", "provider", "accountId", "roleArn", "externalId", "regions", "access", "status", "createdAt", "lastVerifiedAt", "error"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "enum": ["aws"] },
        "accountId": { "type": ["string", "null"], "pattern": "^\\d{12}$", "description": "null until the role is verified." },
        "roleArn": { "type": ["string", "null"], "description": "null until the customer pastes the role ARN." },
        "externalId": { "type": "string", "minLength": 1, "description": "Shared secret the trust policy requires; rotatable." },
        "regions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "access": { "const": "read-only" },
        "status": { "enum": ["pending", "verifying", "connected", "failed", "revoked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastVerifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "error": { "type": ["string", "null"] }
      }
    },
    "repo_selection": {
      "description": "Which repositories the GitHub App can see.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "all" } }
        },
        {
          "type": "object",
          "required": ["kind", "repos"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "selected" },
            "repos": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
              "description": "owner/name, each one also listed in availableRepos."
            }
          }
        }
      ]
    },
    "github_permission": {
      "type": "object",
      "required": ["scope", "access", "reason"],
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "string", "minLength": 1, "description": "GitHub App permission name, e.g. actions, pull_requests." },
        "access": { "enum": ["read", "write"] },
        "reason": { "type": "string", "minLength": 1, "description": "Why Infrared asks for it, shown to the customer." }
      }
    },
    "github_installation": {
      "type": "object",
      "required": ["status", "org", "installationId", "repoSelection", "availableRepos", "permissions", "installedAt", "extensionReady"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["not_connected", "connected", "suspended"] },
        "org": { "type": ["string", "null"], "description": "GitHub organisation login; null when not connected." },
        "installationId": { "type": ["integer", "null"], "minimum": 1 },
        "repoSelection": { "$ref": "#/$defs/repo_selection" },
        "availableRepos": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" } },
        "permissions": { "type": "array", "items": { "$ref": "#/$defs/github_permission" } },
        "installedAt": { "type": ["string", "null"], "format": "date-time" },
        "extensionReady": { "type": "boolean", "description": "true when the Chrome extension can show Infrared data in this org." }
      }
    }
  }
}
