{
  "manifest_version": 3,
  "name": "Infrared",
  "version": "0.1.0",
  "description": "The latest Infrared run and GitHub Actions runner suggestions inside GitHub.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Infrared" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
